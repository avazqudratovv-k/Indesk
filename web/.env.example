# Public values only. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side only (no NEXT_PUBLIC_): where the Next server reaches the API. Used for the dev /api rewrite
# and for the server-side /api/me call. Defaults to http://127.0.0.1:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

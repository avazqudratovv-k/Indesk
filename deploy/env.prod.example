# Production settings for the VPS. On the server: cp deploy/env.prod.example .env  (in the repo folder), then fill in
# the values. NEVER commit the real file (.gitignore ignores .env). All values below are placeholders.

# Makes a bare `docker compose` use only the production file. The dev files are never loaded.
COMPOSE_FILE=compose.prod.yaml

# Database logins. Hex passwords stay safe inside URLs. Generate each with:  openssl rand -hex 24
# They are applied only when the database volume is first created (see deploy/RUNBOOK.md to change them later).
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_PASSWORD=change-me-app

# Signs tokens and keys the IP/email hashes. At least 32 characters; the API will not start without it.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=change-me-at-least-32-characters-long

# Paid Google Gemini key with a monthly spending limit. Only the worker container receives it.
GEMINI_API_KEY=change-me-gemini-key

# Resend (sends the password-reset and verification emails). Only the worker container receives these two.
# RESEND_API_KEY: an API key with "Sending access" for the verified domain. EMAIL_FROM: keep the double quotes, the
# value has spaces and angle brackets. The domain in it must be verified in Resend (indesk.uz is).
RESEND_API_KEY=change-me-resend-key
EMAIL_FROM="Indesk <no-reply@indesk.uz>"

# The address that links in emails point to: https, no path, no trailing slash, and one of ALLOWED_ORIGINS.
# Now the sslip.io host; it becomes https://indesk.uz with the domain switch (deploy/RUNBOOK.md).
APP_BASE_URL=https://indesk.76-13-198-17.sslip.io

# 0 = anyone may start a run; 1 = a run needs a verified email. Keep 0 until a reset and a verification email have
# arrived in a real mailbox, then set 1 and run `docker compose up -d api`.
EMAIL_VERIFICATION_REQUIRED=0

# Origins allowed to send write requests (CSRF check). Exact browser origin: https, no port, no trailing slash.
# Comma-separated; list both hosts while moving to indesk.uz.
ALLOWED_ORIGINS=https://indesk.76-13-198-17.sslip.io

# Subnet of the compose "edge" network (web <-> api). It is pinned so the API can trust exactly it as the proxy
# range (TRUSTED_PROXIES is taken from this value). It must not overlap any Docker network already on the server:
# check with  docker network inspect $(docker network ls -q) | grep Subnet
EDGE_SUBNET=172.29.41.0/24

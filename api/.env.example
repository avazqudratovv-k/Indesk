# Copy to api/.env and fill in real values yourself. Never commit api/.env.
# Docker Compose sets DATABASE_URL and REDIS_URL for the containers; these are for reference.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://indesk:replace-me@db:5432/indesk
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=replace-me
AUTH_SECRET=replace-me
GEMINI_API_KEY=replace-me

ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=

# DB roles (dev defaults live in compose.yaml; set real values for production)
POSTGRES_MIGRATOR_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
# SESSION_MAX_SECONDS=21600
